# Copy this file to .env and fill in your own values. Never commit .env.

# Where the database lives. SQLite by default; a PostgreSQL address also works.
DATABASE_URL=sqlite:///revisiontrack.db

# REQUIRED. A random value of at least 32 characters. The app refuses to start without one.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME

# Optional. Websites allowed to call the API from a browser, comma separated. Empty means none.
CORS_ORIGINS=

# Set to 1 only when deployed behind a host's proxy (Render), so rate limits use the real client address.
BEHIND_PROXY=0

FLASK_APP=app
FLASK_DEBUG=1
